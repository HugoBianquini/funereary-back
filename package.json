{
  "name": "funereasy-api",
  "version": "1.0.0",
  "description": "API REST para serviços funerários FunerEasy",
  "main": "dist/shared/infra/http/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/shared/infra/http/server.ts",
    "build": "tsc",
    "start": "node dist/shared/infra/http/server.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:generate": "npm run typeorm -- migration:generate src/shared/infra/typeorm/migrations/$npm_config_name -d src/shared/infra/typeorm/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/shared/infra/typeorm/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/shared/infra/typeorm/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/shared/infra/typeorm/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/multer": "^1.4.10",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  }
}
